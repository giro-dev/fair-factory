FANEL_DB_URL=jdbc:postgresql://postgres:5432/fanel
FANEL_DB_USER=fanel
FANEL_DB_PASSWORD=change-me
FANEL_ADMIN_USER=admin
FANEL_ADMIN_PASSWORD=change-me
FANEL_CORS_ORIGINS=http://localhost:8080

# Spring AI configuration (optional; no provider is enabled by default)
# SPRING_AI_OLLAMA_BASE_URL=http://localhost:11434
# SPRING_AI_OPENAI_API_KEY=sk-...
# SPRING_AI_ANTHROPIC_API_KEY=sk-ant-...
# Optional: external ICS calendar refresh interval (minutes)
# FANEL_CALENDAR_ICS_REFRESH_MINUTES=60

# Optional: scheduled JSON backups (one file per household per day under FANEL_BACKUPS_DIR;
# mount the directory inside the app data volume, e.g. /data/backups)
# FANEL_BACKUPS_DIR=/data/backups
# FANEL_BACKUPS_HOUR=3
# FANEL_BACKUPS_KEEP_DAYS=30

# Optional: Prometheus metrics endpoint (requires authentication when enabled)
# FANEL_METRICS_ACCESS=read-only

# Optional: external SSO login via OIDC (Authelia, Authentik, Google…). Disabled when unset.
# Authelia example (the member's username must match the OIDC username claim):
# FANEL_OIDC_ISSUER=https://auth.example.com
# FANEL_OIDC_CLIENT_ID=fanel
# FANEL_OIDC_CLIENT_SECRET=change-me
# FANEL_OIDC_NAME=Authelia
# FANEL_OIDC_USERNAME_CLAIM=preferred_username
# FANEL_OIDC_SCOPES=openid,profile,email
